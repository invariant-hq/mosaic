;; Allocation counts follow the profile: dev compiles with -opaque, so a dev
;; build would be judged against counts measured in release.

(rule
 (alias bench)
 (enabled_if
  (<> %{profile} release))
 (action
  (system
   "echo 'benchmarks measure release builds: dune build --profile release @bench' >&2; exit 1")))

(executable
 (name bench_ansi)
 (modules bench_ansi)
 (libraries thumper matrix.ansi))

(executable
 (name bench_text)
 (modules bench_text)
 (libraries thumper matrix.text))

(executable
 (name bench_input)
 (modules bench_input)
 (libraries thumper matrix.input))

(executable
 (name bench_grid)
 (modules bench_grid)
 (libraries thumper matrix.grid matrix.ansi))

(executable
 (name bench_screen)
 (modules bench_screen)
 (libraries thumper matrix.screen matrix.grid matrix.ansi))

(executable
 (name bench_runtime)
 (modules bench_runtime)
 (libraries thumper matrix))

(rule
 (alias bench)
 (enabled_if
  (= %{profile} release))
 (deps
  (env_var THUMPER_MACHINE))
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_ansi.exe} --wait-quiet 60)
   (diff? ansi.thumper ansi.thumper.corrected))))

