;; Allocation counts follow the profile: dev compiles with -opaque, so a dev
;; build would be judged against counts measured in release.

(rule
 (alias bench)
 (enabled_if
  (<> %{profile} release))
 (action
  (system
   "echo 'benchmarks measure release builds: dune build --profile release @bench' >&2; exit 1")))

(executable
 (name bench_renderer)
 (modules bench_renderer)
 (libraries thumper mosaic.ui toffee))

(rule
 (alias bench)
 (enabled_if
  (= %{profile} release))
 (deps
  (env_var THUMPER_MACHINE))
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_renderer.exe} --wait-quiet 60)
   (diff? renderer.thumper renderer.thumper.corrected))))

