; The examples that run a program from another event loop, run in a
; pseudo-terminal. Those whose event loop is not installed are skipped, and
; all of them on Windows, which has no pseudo-terminal (see pty.mli).

(executable
 (name test_examples)
 (libraries windtrap matrix.test matrix.vte matrix.pty unix))

(rule
 (alias runtest)
 (package mosaic)
 (enabled_if
  (and
   (= %{os_type} Unix)
   %{lib-available:eio_main}))
 (action
  (run
   %{exe:test_examples.exe}
   %{dep:../../examples/24-eio/main.exe}
   "Async Tasks")))

(rule
 (alias runtest)
 (package mosaic)
 (enabled_if
  (and
   (= %{os_type} Unix)
   %{lib-available:lwt.unix}))
 (action
  (run
   %{exe:test_examples.exe}
   %{dep:../../examples/26-lwt/main.exe}
   "Lwt timers")))

(rule
 (alias runtest)
 (package mosaic)
 (enabled_if
  (= %{os_type} Unix))
 (action
  (run
   %{exe:test_examples.exe}
   %{dep:../../examples/27-threads/main.exe}
   "Thread feed")))
